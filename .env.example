# Copy to .env. Optional tuning: .env.advanced.example
# Generate your own secret: python3 -c 'import secrets; print(secrets.token_hex(32))'
APP_SESSION_SECRET=
APP_ENV=development
APP_PORT=8005
APP_DATA_DIR=data
TZ=Asia/Tokyo
# Required in production (PostgreSQL); development defaults to SQLite.
APP_DB_URL=

# Speech recognition: whisper or qwen3_vllm
ASR_BACKEND=whisper
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_DEFAULT_LANGUAGE=auto
# Qwen example: ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# Both recognition stages use the same URL/model.
ASR_REALTIME_WINDOW_SECONDS=5
ASR_HIGH_ACCURACY_ENABLED=1
ASR_HIGH_ACCURACY_WINDOW_SECONDS=60

# Meeting assistant + summary (requires login)
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-4o-mini

# Proofreading (optional)
PROOFREAD_BASE_URL=
PROOFREAD_API_KEY=
PROOFREAD_MODEL=gpt-4o-mini

# Access: guests can transcribe, but cannot use the meeting assistant.
ENABLE_SELF_SIGNUP=0
ALLOW_GUEST_TRANSCRIPTION=0
APP_PUBLIC_URL=
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Speaker identification (optional; requires pyannote model access)
DIARIZATION_ENABLED=0
CONTAINER_INSTALL_DIARIZATION=0
DIARIZATION_HF_TOKEN=

# Container
CONTAINER_IMAGE_NAME=whistx:latest
CONTAINER_NAME=whistx
CONTAINER_BUILD_POLICY=missing
PODMAN_NETWORK=slirp4netns:allow_host_loopback=true

# Optional tracing: set keys/host only when enabled.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
