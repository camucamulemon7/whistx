# Copy to .env. Configure ASR/summary models, access and retention in /admin.
# Model settings persist in APP_DATA_DIR/admin-settings.json across restarts.
# Generate your own secret: python3 -c 'import secrets; print(secrets.token_hex(32))'
APP_SESSION_SECRET=
APP_ENV=development
APP_PORT=8005
APP_DATA_DIR=data
TZ=Asia/Tokyo
# Required in production (PostgreSQL); development defaults to SQLite.
APP_DB_URL=
APP_PUBLIC_URL=
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Container. Set always to rebuild after source updates.
CONTAINER_IMAGE_NAME=whistx:latest
CONTAINER_NAME=whistx
CONTAINER_BUILD_POLICY=missing
PODMAN_NETWORK=slirp4netns:allow_host_loopback=true
# WSL without a systemd user session may require: PODMAN_CGROUP_MANAGER=cgroupfs
# Optional infrastructure/tuning overrides: .env.advanced.example
